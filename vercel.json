{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "vite-project": {
      "root": "client/vite-project",
      "framework": "vite"
    },
    "server": {
      "root": "server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "vite-project"
      }
    }
  ]
}
